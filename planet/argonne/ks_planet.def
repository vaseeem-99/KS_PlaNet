Bootstrap: docker
From: nvcr.io/nvidia/tensorflow:20.10-tf1-py3

%labels
    Maintainer KS-PlaNet
    Description PlaNet for KS and Kolmogorov PDE world-model learning

%environment
    export TF_CPP_MIN_LOG_LEVEL=2
    export PATH=/usr/local/bin:${PATH}

%post
    set -e
    export PATH=/usr/local/bin:${PATH}

    python -m pip install --no-cache-dir --upgrade pip==21.3.1 setuptools wheel
    python -m pip install --no-cache-dir cmake

    pip install --no-cache-dir 'cloudpickle==1.3.0'
    pip install --no-cache-dir --no-deps 'tensorflow_probability==0.8.0'

    pip install --no-cache-dir \
        'gym>=0.17.0,<=0.21.0' \
        'dm-tree==0.1.6' \
        'labmaze==1.0.3' \
        'dm_control' \
        'ruamel.yaml>=0.15.0,<0.16.0' \
        'scikit-image>=0.17.0' \
        'opencv-python-headless==4.3.0.38'

%runscript
    exec "$@"
