#!/bin/bash
# ============================================================================
# 02_train_ks.pbs -- Train PlaNet on KS (1 node, 1 A100)
# ============================================================================
# Queue:    preemptable (1-10 nodes, up to 72h walltime, can be preempted)
# Restart:  #PBS -r y -- if preempted by a demand job, auto-resubmits
#
# Submit:   qsub 02_train_ks.pbs
# Resubmit chained:  qsub -W depend=afterany:<jobid> 02_train_ks.pbs
# ============================================================================

#PBS -N ks_planet_train_ks
#PBS -A PIGAN
#PBS -q preemptable
#PBS -r y
#PBS -l select=1:system=polaris
#PBS -l walltime=24:00:00
#PBS -l filesystems=home:eagle
#PBS -l place=scatter
#PBS -j oe
#PBS -o ks_planet_train_ks.pbs.out

PROJECT="PIGAN"
PROJ_DIR="/eagle/projects/${PROJECT}/${USER}/ks_planet"
REPO_DIR="${PROJ_DIR}/code"
CODE_DIR="${REPO_DIR}/planet"
SIF="${PROJ_DIR}/containers/ks-planet.sif"
LOGDIR="${PROJ_DIR}/checkpoints/ks_run"
BACKUPDIR="${PROJ_DIR}/checkpoints/ks_run_backup"
MAX_STEPS="${MAX_STEPS:-2000000}"

set -euo pipefail

cd "${CODE_DIR}"
mkdir -p "${PROJ_DIR}/logs"
exec > >(tee -a "${PROJ_DIR}/logs/train_ks.out") 2>&1

export HTTP_PROXY="http://proxy.alcf.anl.gov:3128"
export HTTPS_PROXY="http://proxy.alcf.anl.gov:3128"
export http_proxy="${HTTP_PROXY}"
export https_proxy="${HTTPS_PROXY}"

ml use /soft/modulefiles
ml spack-pe-base
ml apptainer

export BASE_SCRATCH_DIR=/local/scratch
export APPTAINER_TMPDIR=${BASE_SCRATCH_DIR}/apptainer-tmpdir
mkdir -p ${APPTAINER_TMPDIR} "${LOGDIR}" "${BACKUPDIR}"

echo "============================================"
echo "Job ID    : ${PBS_JOBID}"
echo "Node      : $(hostname)"
echo "GPU info  : $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader)"
echo "Repo dir  : ${REPO_DIR}"
echo "Logdir    : ${LOGDIR}     (data + ckpt OUTSIDE container)"
echo "MAX_STEPS : ${MAX_STEPS}"
echo "Start     : $(date)"
echo "============================================"

# ── Periodic checkpoint backup (runs in background) ────────────────────────
# Copies the latest checkpoint to /eagle every 30 min so a preempt mid-write
# doesn't corrupt the final state.
(
    while true; do
        sleep 1800
        if [ -d "${LOGDIR}" ]; then
            timestamp=$(date +%Y%m%d_%H%M%S)
            rsync -a --delete "${LOGDIR}/" "${BACKUPDIR}/snapshot_${timestamp}/" 2>/dev/null || true
            # keep only the last 3 backups
            ls -1dt "${BACKUPDIR}/snapshot_"* 2>/dev/null | tail -n +4 | xargs rm -rf 2>/dev/null || true
        fi
    done
) &
BACKUP_PID=$!
trap "kill ${BACKUP_PID} 2>/dev/null" EXIT

# ── Lib check ───────────────────────────────────────────────────────────────
echo ""
echo ">>> Library check..."
apptainer exec --nv --bind "${PROJ_DIR}:${PROJ_DIR}" "${SIF}" python -c "
import tensorflow as tf, tensorflow_probability
print(f'  TF: {tf.__version__}, GPU OK: {tf.test.is_gpu_available()}')
"

# ── Run training inside container ───────────────────────────────────────────
echo ""
echo ">>> Starting KS training..."
apptainer exec --nv \
    --bind "${PROJ_DIR}:${PROJ_DIR}" \
    --bind "${HOME}:${HOME}" \
    --env http_proxy="${http_proxy}" \
    --env https_proxy="${https_proxy}" \
    --env TF_CPP_MIN_LOG_LEVEL=2 \
    "${SIF}" \
    python -m planet.scripts.train \
        --logdir "${LOGDIR}" \
        --config ks_config \
        --params "{tasks: [ks_chaos], max_steps: ${MAX_STEPS}, train_dir: ${CODE_DIR}/ks_dataset/train_episodes, test_dir: ${CODE_DIR}/ks_dataset/test_episodes}" \
    2>&1 | tee "${PROJ_DIR}/logs/ks_train.log"

# ── Final backup ────────────────────────────────────────────────────────────
echo ""
echo ">>> Final checkpoint backup..."
final_ts=$(date +%Y%m%d_%H%M%S)
rsync -a "${LOGDIR}/" "${BACKUPDIR}/final_${final_ts}/"
echo "  Backed up to ${BACKUPDIR}/final_${final_ts}/"

echo ""
echo "End: $(date)"
